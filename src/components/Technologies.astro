---
const categories = [
  {
    name: "Frontend",
    icon: "🎨",
    color: "#6366f1",
    techs: [
      { name: "React",       level: 90, icon: "⚛️",  desc: "Hooks, Context, Redux" },
      { name: "TypeScript",  level: 85, icon: "🔷",  desc: "Tipos, Generics, Decorators" },
      { name: "Astro",       level: 80, icon: "🚀",  desc: "SSG, Islands, Integrations" },
      { name: "Tailwind CSS",level: 88, icon: "🎀",  desc: "Utility-first, Responsive" },
      { name: "Next.js",     level: 82, icon: "▲",   desc: "SSR, App Router, API Routes" },
    ],
  },
  {
    name: "Backend",
    icon: "⚙️",
    color: "#a78bfa",
    techs: [
      { name: "Node.js",     level: 85, icon: "🟢",  desc: "Express, Fastify, REST" },
      { name: "Python",      level: 78, icon: "🐍",  desc: "FastAPI, Django, Scripts" },
      { name: "PostgreSQL",  level: 80, icon: "🐘",  desc: "Queries, Migrations, Indexes" },
      { name: "MongoDB",     level: 75, icon: "🍃",  desc: "Aggregations, Atlas, Mongoose" },
      { name: "GraphQL",     level: 70, icon: "◉",   desc: "Apollo, Resolvers, Schemas" },
    ],
  },
  {
    name: "DevOps & Herramientas",
    icon: "🛠️",
    color: "#22d3ee",
    techs: [
      { name: "Git",         level: 92, icon: "🔀",  desc: "GitHub, Branching, CI/CD" },
      { name: "Docker",      level: 72, icon: "🐳",  desc: "Containers, Compose, Images" },
      { name: "Linux",       level: 80, icon: "🐧",  desc: "Shell, Cron, SSH" },
      { name: "Figma",       level: 68, icon: "🎭",  desc: "Design, Prototyping" },
      { name: "Vercel",      level: 85, icon: "▲",   desc: "Deploy, Edge, Analytics" },
    ],
  },
];
---

<section class="technologies" id="tecnologias">
  <div class="container">
    <div class="section-header">
      <p class="section-label">Stack técnico</p>
      <h2 class="section-title">Tecnologías que <span>domino</span></h2>
      <p class="section-subtitle">
        Herramientas y lenguajes con los que construyo soluciones reales, día a día.
      </p>
    </div>

    <div class="categories">
      {categories.map((cat, ci) => (
        <div class="category" style={`--cat-color: ${cat.color}`}>
          <div class="cat-header">
            <span class="cat-icon">{cat.icon}</span>
            <h3 class="cat-name">{cat.name}</h3>
          </div>

          <div class="tech-list">
            {cat.techs.map((tech) => (
              <div class="tech-item">
                <div class="tech-top">
                  <span class="tech-icon">{tech.icon}</span>
                  <span class="tech-name">{tech.name}</span>
                  <span class="tech-pct">{tech.level}%</span>
                </div>
                <div class="tech-desc">{tech.desc}</div>
                <div class="progress-track">
                  <div
                    class="progress-fill"
                    style={`--pct: ${tech.level}%; --color: ${cat.color}`}
                  ></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Tech cloud badges -->
    <div class="tech-badges">
      {categories.flatMap(c => c.techs).map(t => (
        <span class="badge">{t.icon} {t.name}</span>
      ))}
    </div>
  </div>
</section>

<style>
  .technologies {
    padding-block: 7rem;
    position: relative;
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }
  .section-subtitle { margin-inline: auto; }

  /* ── Categories grid ── */
  .categories {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .category {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    transition: border-color var(--transition), transform var(--transition);
  }
  .category:hover {
    border-color: var(--cat-color);
    transform: translateY(-4px);
  }

  .cat-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }
  .cat-icon { font-size: 1.5rem; }
  .cat-name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--cat-color);
  }

  /* ── Tech item ── */
  .tech-list { display: flex; flex-direction: column; gap: 1.1rem; }

  .tech-item {}

  .tech-top {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.2rem;
  }
  .tech-icon { font-size: 1rem; }
  .tech-name {
    font-size: 0.9rem;
    font-weight: 600;
    flex: 1;
  }
  .tech-pct {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-dim);
  }
  .tech-desc {
    font-size: 0.75rem;
    color: var(--text-dim);
    margin-bottom: 0.5rem;
  }

  /* ── Progress bar ── */
  .progress-track {
    height: 5px;
    background: rgba(255,255,255,0.06);
    border-radius: 100px;
    overflow: hidden;
  }
  .progress-fill {
    height: 100%;
    width: var(--pct);
    background: var(--color);
    border-radius: 100px;
    animation: fillBar 1.2s ease both;
    box-shadow: 0 0 8px var(--color);
  }
  @keyframes fillBar {
    from { width: 0; }
    to   { width: var(--pct); }
  }

  /* ── Badge cloud ── */
  .tech-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
    margin-top: 1rem;
  }
  .badge {
    background: var(--bg-card2);
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 0.3rem 0.8rem;
    font-size: 0.78rem;
    color: var(--text-muted);
    transition: var(--transition);
  }
  .badge:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: rgba(99,102,241,0.08);
  }
</style>

